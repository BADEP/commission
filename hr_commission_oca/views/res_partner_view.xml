<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_form_agent" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="commission_oca.view_partner_form_agent" />
        <field name="arch" type="xml">
            <field name="commission_id" position="after">
                <field name="employee" invisible="agent_type != 'salesman'" />
            </field>
        </field>
    </record>
</odoo>
